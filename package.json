{
  "name": "kaalkrit",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:content && npm run test:unit",
    "test:content": "node --test tests/*.test.mjs",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/release-e2e.mjs",
    "test:deployment": "node scripts/verify-vercel-deployment.mjs",
    "test:deployment:current": "VERIFY_CURRENT_DEPLOYMENT=true node scripts/verify-vercel-deployment.mjs",
    "e2e": "npm run test:e2e",
    "test:secrets": "node scripts/check-client-secrets.mjs",
    "security:scan": "npm audit --audit-level=high && npm run test:secrets"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.1",
    "next": "^16.3.0",
    "ogl": "^1.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.35.0",
    "eslint-config-next": "^16.3.0",
    "eslint-plugin-security": "^4.0.1",
    "jsdom": "^29.1.1",
    "prettier": "3.9.6",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
